{
  "info": {
    "name": "Chimoney API",
    "description": "Chimoney global payouts and disbursement REST API (v0.2). Base URL: https://api.chimoney.io (production) or https://api-v2-sandbox.chimoney.io (sandbox). All requests are authenticated with an API key in the X-API-KEY header, issued from https://dash.chimoney.io/developers. Grounded in the live OpenAPI (https://api.chimoney.io/v0.2/swagger.json, spec 0.2.2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-KEY",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
